{
  "name": "vista",
  "version": "1.0.0",
  "private": true,
  "description": "A responsive hospitality demonstration website built with HTML, CSS, and vanilla JavaScript, featuring accessibility, PWA, SEO, and light/dark themes.",
  "author": "Kamil Król — KP_Code Digital Studio",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KPKrol85/DS-hospitality-pr01-Vista.git"
  },
  "homepage": "https://ds-hospitality-pr01-vista.netlify.app/",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "preview": "node scripts/preview-dist.mjs",
    "build:css": "postcss ./css/style.css -o ./dist/css/style.min.css && node ./scripts/verify-build.mjs css ./dist/css/style.min.css",
    "build:js": "esbuild ./js/script.js --bundle --minify --target=es2018 --format=iife --outfile=./dist/js/script.min.js && node ./scripts/verify-build.mjs js ./dist/js/script.min.js",
    "build": "npm run build:dist",
    "dist:clean": "node ./scripts/build-dist.mjs --clean",
    "build:dist": "npm run dist:clean && npm run build:css && npm run build:js && node ./scripts/build-dist.mjs",
    "img:opt": "node scripts/optimize-images.mjs",
    "img:clean": "node scripts/optimize-images.mjs --clean",
    "img:watch": "node scripts/optimize-images.mjs --watch",
    "test": "echo \"Error: no test specified\" && exit 1",
    "check:links": "node scripts/check-link-integrity.mjs",
    "check:syntax": "node scripts/qa-syntax.mjs",
    "check:booking-date": "node scripts/check-booking-date.mjs",
    "check:jsonld": "node scripts/check-jsonld-pairs.mjs",
    "check:image-descriptors": "node scripts/check-image-descriptors.mjs",
    "qa:fast": "npm run check:links && npm run check:syntax && npm run check:booking-date && npm run check:jsonld && npm run check:image-descriptors",
    "test:a11y": "node scripts/a11y-axe.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "axe-core": "^4.10.3",
    "chokidar": "^4.0.3",
    "cssnano": "^7.1.2",
    "esbuild": "^0.25.10",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "sharp": "^0.34.4"
  }
}
